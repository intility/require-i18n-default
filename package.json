{
  "name": "@intility/oxlint-plugin-require-i18n-default",
  "version": "2.0.0",
  "description": "Oxlint plugin to enforce default values in i18next translation functions and Trans components",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "vp check",
    "test": "vp test",
    "build": "vp pack"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.92.0"
  },
  "devDependencies": {
    "oxlint": "^1.92.0",
    "typescript": "^5.9.3",
    "vite-plus": "^1.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.20.0"
}
